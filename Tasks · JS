const express = require("express");
const TaskManager = require("../services/TaskManager");

const router = express.Router();
const manager = new TaskManager();

// ---- SELECT (list, with optional filtering) ----
// GET /tasks?status=pending&priority=high
router.get("/", (req, res) => {
  const { status, priority } = req.query;
  const tasks = manager.listTasks({ status, priority });
  res.json(tasks);
});

// ---- SELECT (single) ----
// GET /tasks/:id
router.get("/:id", (req, res) => {
  const task = manager.getTask(Number(req.params.id));
  if (!task) return res.status(404).json({ message: "Task not found." });
  res.json(task);
});

// ---- CREATE ----
// POST /tasks  { title, priority }
router.post("/", (req, res) => {
  try {
    const { title, priority } = req.body;
    const task = manager.addTask(title, priority);
    res.status(201).json(task);
  } catch (err) {
    res.status(400).json({ message: err.message });
  }
});

// ---- UPDATE (fields) ----
// PATCH /tasks/:id  { title?, priority? }
router.patch("/:id", (req, res) => {
  try {
    const task = manager.updateTask(Number(req.params.id), req.body);
    if (!task) return res.status(404).json({ message: "Task not found." });
    res.json(task);
  } catch (err) {
    res.status(400).json({ message: err.message });
  }
});

// ---- UPDATE (toggle completed) ----
// PATCH /tasks/:id/toggle
router.patch("/:id/toggle", (req, res) => {
  const task = manager.toggleComplete(Number(req.params.id));
  if (!task) return res.status(404).json({ message: "Task not found." });
  res.json(task);
});

// ---- REMOVE ----
// DELETE /tasks/:id
router.delete("/:id", (req, res) => {
  const deleted = manager.deleteTask(Number(req.params.id));
  if (!deleted) return res.status(404).json({ message: "Task not found." });
  res.status(204).end();
});

module.exports = router;
